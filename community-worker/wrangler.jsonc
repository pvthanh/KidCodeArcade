{
  "name": "little-level-lab-library",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB",
    "database_name": "little-level-lab-library",
    "database_id": "fb151fd0-abbc-4d42-b03c-3e8e521bf89c"
  }],
  "ratelimits": [
    { "name": "WRITE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ]
}
